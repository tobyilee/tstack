--- /dev/null
+++ b/src/garden/projection.ts
@@ -0,0 +1,27 @@
+// Isometric (2:1 dimetric) projection helpers.
+export const TILE_W = 64;
+export const TILE_H = 32;
+
+export interface GridPos { gx: number; gy: number }
+export interface ScreenPos { sx: number; sy: number }
+
+/** Grid cell -> screen pixel (top corner of the diamond). */
+export function gridToScreen({ gx, gy }: GridPos, origin: ScreenPos): ScreenPos {
+  return {
+    sx: origin.sx + (gx - gy) * (TILE_W / 2),
+    sy: origin.sy + (gx + gy) * (TILE_H / 2),
+  };
+}
+
+/** Screen pixel -> fractional grid cell (inverse of gridToScreen). */
+export function screenToGrid({ sx, sy }: ScreenPos, origin: ScreenPos): GridPos {
+  const x = (sx - origin.sx) / (TILE_W / 2);
+  const y = (sy - origin.sy) / (TILE_H / 2);
+  return { gx: (x + y) / 2, gy: (y - x) / 2 };
+}
+
+/** Larger depth = closer to the viewer = drawn later. */
+export function depthKey(p: GridPos, z = 0): number {
+  return (p.gx + p.gy) * 100 + z;
+}
